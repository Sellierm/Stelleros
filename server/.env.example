# Server runtime
NODE_ENV=development
PORT=4200
IP=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4200

# Database
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# GPS ingest security
GPS_INGEST_KEY=
GPS_ALLOWED_IDS=example_id1,example_id2

# Google Maps
GOOGLE_MAPS_API_KEY=

# Plans de la ferme (une URL par année depuis 2022, séparées par des virgules).
# Si vide, modules/mapModule.js est lu s'il existe.
MAP_PLAN_URLS=

# OpenWeather
OPENWEATHER_API_KEY=
FORECAST_LATITUDE=
FORECAST_LONGITUDE=
FORECAST_CITY=

# Sencrop
SENCROP_USER_ID=
SENCROP_ORGANISATIONS_IDS=
SENCROP_APPLICATION_ID=
SENCROP_APPLICATION_SECRET=
SENCROP_WINDCROP_EARL_ID=
SENCROP_RAINCROP_EARL_ID=
SENCROP_ENDPOINT=https://api.sencrop.com/v1
SENCROP_INCLUDE_HISTORY_USER=false

BETTER_AUTH_SECRET=      # openssl rand -base64 32
BETTER_AUTH_URL=         # URL publique en https
BETTER_AUTH_TRUSTED_ORIGINS=

# Build React servi par l'API (défaut : ../client/dist)
CLIENT_DIST=
